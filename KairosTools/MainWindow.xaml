<Window x:Class="KairosTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:KairosTools"
        ui:WindowHelper.UseModernWindowStyle="True"
        Icon="pack://application:,,,/app.ico"
        Title="KairosTools" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Height="40" Margin="8,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="indicator" Grid.Column="0" Background="Transparent" CornerRadius="2" Margin="0,8"/>
                                <TextBlock x:Name="icon" Grid.Column="1" FontFamily="Segoe MDL2 Assets"
                                           Text="{TemplateBinding Tag}" FontSize="16"
                                           Foreground="#0078D4"
                                           Margin="14,0,12,0" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C7DCF2"/>
                                <Setter TargetName="indicator" Property="Background" Value="#004A8F"/>
                                <Setter TargetName="icon" Property="Foreground" Value="#004A8F"/>
                                <Setter Property="Foreground" Value="#004A8F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubNavButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Height="34" Margin="20,1,8,1">
                            <ContentPresenter Margin="30,0,0,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E8F0FE"/>
                                <Setter Property="Foreground" Value="#0078D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwitchStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="statusText" Text="已禁用"
                                       FontSize="12" Foreground="#888888"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Border x:Name="track" Width="40" Height="20" CornerRadius="10" Background="#CCCCCC">
                                <Border x:Name="thumb" Width="16" Height="16" CornerRadius="8"
                                        Background="White" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0"/>
                                <Setter TargetName="statusText" Property="Text" Value="已启用"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsOnRecommended}" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#0078D4"/>
                                <Setter TargetName="statusText" Property="Foreground" Value="#0078D4"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOnRecommended}" Value="False">
                                <Setter TargetName="track" Property="Background" Value="#E74C3C"/>
                                <Setter TargetName="statusText" Property="Foreground" Value="#E74C3C"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ItemHeaderButtonStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="0,14">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            <Setter Property="CacheMode">
                <Setter.Value>
                    <BitmapCache RenderAtScale="2"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#0078D4"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent"
                                BorderBrush="#0078D4" BorderThickness="1.5"
                                CornerRadius="10" Padding="40,14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E8F0FE"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                To="1.05" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="1.05" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                To="1" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="1" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C7DCF2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E5E5E5" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="KairosTools" FontSize="18" FontWeight="Bold"
                               Margin="20,0,0,24" Foreground="#0078D4"/>

                    <RadioButton x:Name="NavHome" GroupName="Nav" Tag="&#xE80F;"
                                 Content="主页" Style="{StaticResource NavButtonStyle}"
                                 IsChecked="True" Checked="Nav_Checked"/>

                    <RadioButton x:Name="NavOptimize" GroupName="Nav" Tag="&#xE945;"
                                 Content="优化" Style="{StaticResource NavButtonStyle}"
                                 Checked="Nav_Checked"/>

                    <StackPanel x:Name="OptimizeSubMenu" Visibility="Collapsed">
                        <RadioButton x:Name="SubOptimizePlan" GroupName="SubNav" Content="调整方案"
                                     Style="{StaticResource SubNavButtonStyle}" Checked="SubNav_Checked"/>
                        <RadioButton x:Name="SubOptimizeBasic" GroupName="SubNav" Content="基础"
                                     Style="{StaticResource SubNavButtonStyle}" Checked="SubNav_Checked"/>
                        <RadioButton x:Name="SubOptimizeSecurity" GroupName="SubNav" Content="安全"
                                     Style="{StaticResource SubNavButtonStyle}" Checked="SubNav_Checked"/>
                        <RadioButton x:Name="SubOptimizePower" GroupName="SubNav" Content="电源管理"
                                     Style="{StaticResource SubNavButtonStyle}" Checked="SubNav_Checked"/>
                        <RadioButton x:Name="SubOptimizePrivacy" GroupName="SubNav" Content="隐私"
                                     Style="{StaticResource SubNavButtonStyle}" Checked="SubNav_Checked"/>
                        <RadioButton x:Name="SubOptimizeTask" GroupName="SubNav" Content="任务"
                                     Style="{StaticResource SubNavButtonStyle}" Checked="SubNav_Checked"/>
                    </StackPanel>

                    <RadioButton x:Name="NavSettings" GroupName="Nav" Tag="&#xE713;"
                                 Content="设置" Style="{StaticResource NavButtonStyle}"
                                 Checked="Nav_Checked"/>

                    <RadioButton x:Name="NavAbout" GroupName="Nav" Tag="&#xE946;"
                                 Content="关于" Style="{StaticResource NavButtonStyle}"
                                 Checked="Nav_Checked"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ★ 右侧内容区：加 ClipToBounds 防止滑入图层溢出到侧栏 -->
        <Grid Grid.Column="1" Background="White" ClipToBounds="True">
            <Grid x:Name="PageHome">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="欢迎使用 KairosTools" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="从左侧选择功能开始" FontSize="14" Foreground="Gray" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="PageOptimizePlan" Visibility="Collapsed">
                <TextBlock Text="调整方案" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <Grid x:Name="PageOptimizeBasic" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="BasicHeader" Grid.Row="0" Margin="30,24,30,12" Opacity="0">
                    <TextBlock Text="基础优化" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="常用的系统基础优化项，点击项目名称查看详细说明"
                               FontSize="12" Foreground="Gray" Margin="0,4,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="BasicItemsControl"
                                  ItemsSource="{Binding BasicItems}" Margin="30,0,30,24">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#EFEFEF" BorderThickness="0,0,0,1" Opacity="0"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Border.RenderTransform>
                                    <StackPanel>
                                        <Grid Height="52">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <ToggleButton Grid.Column="0"
                                                          IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                          Style="{StaticResource ItemHeaderButtonStyle}"
                                                          HorizontalContentAlignment="Left">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                    <!-- ★ 箭头：向右的箭头，展开时顺时针旋转 90° 变成向下 -->
                                                    <TextBlock x:Name="arrow" FontFamily="Segoe MDL2 Assets"
                                                               Text="&#xE76C;" FontSize="10" Foreground="#888888"
                                                               Margin="8,1,0,0" VerticalAlignment="Center"
                                                               RenderTransformOrigin="0.5,0.5">
                                                        <TextBlock.RenderTransform>
                                                            <RotateTransform Angle="0"/>
                                                        </TextBlock.RenderTransform>
                                                    </TextBlock>
                                                </StackPanel>
                                            </ToggleButton>

                                            <ToggleButton Grid.Column="1"
                                                          IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                          Style="{StaticResource SwitchStyle}"
                                                          VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- ★ 展开区域：用 AnimatedExpander 附加属性做高度动画 -->
                                        <Border local:AnimatedExpander.IsExpanded="{Binding IsExpanded}"
                                                ClipToBounds="True"
                                                Opacity="0"
                                                Height="0"
                                                Visibility="Collapsed">
                                            <Border Padding="0,0,0,16">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                               Foreground="#666666" FontSize="13" LineHeight="20"/>
                                                    <TextBlock Text="{Binding RecommendText}" FontSize="12"
                                                               Foreground="#0078D4" Margin="0,10,0,0"
                                                               TextWrapping="Wrap" LineHeight="18"/>
                                                </StackPanel>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <DataTemplate.Triggers>
                                    <!-- ★ 箭头旋转动画（可中途打断） -->
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetName="arrow"
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                        To="90" Duration="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetName="arrow"
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                        To="0" Duration="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="PageOptimizeSecurity" Visibility="Collapsed">
                <TextBlock Text="安全优化" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <Grid x:Name="PageOptimizePower" Visibility="Collapsed">
                <TextBlock Text="电源管理" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <Grid x:Name="PageOptimizePrivacy" Visibility="Collapsed">
                <TextBlock Text="隐私优化" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <Grid x:Name="PageOptimizeTask" Visibility="Collapsed">
                <TextBlock Text="任务管理" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <Grid x:Name="PageSettings" Visibility="Collapsed">
                <TextBlock Text="设置页面" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <Grid x:Name="PageAbout" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Ellipse Width="190" Height="190" HorizontalAlignment="Center">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="pack://application:,,,/avatar.jpg" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>

                    <TextBlock Text="Sh1r0ko" FontSize="38" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,30,0,0"
                               Foreground="#1A1A1A"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,40,0,0">
                        <Button Content="B站主页" Click="OpenBilibili"
                                Style="{StaticResource LinkButtonStyle}" Margin="0,0,10,0"/>
                        <Button Content="GitHub" Click="OpenGithub"
                                Style="{StaticResource LinkButtonStyle}" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <Border x:Name="Toast" Grid.ColumnSpan="2"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Background="#333333" CornerRadius="8" Padding="20,12"
                Margin="0,0,0,40" Opacity="0" Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="13"/>
        </Border>
    </Grid>
</Window>